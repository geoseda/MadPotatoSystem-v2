# Copy to .env (never commit it) or set these in your host's dashboard.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=owner
ADMIN_PASSWORD=choose-a-strong-password
DB_PATH=data/mapo.db
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 when served over https.
# Optional low-stock alerts to Telegram:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
